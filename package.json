{
	"name": "cleanup-cloudflare-deployments",
	"description": "Delete old Cloudflare deployments according to settings.",
	"keywords": [
		"Actions",
		"GitHub",
		"Cloudflare",
		"Cleanup",
		"Deployments",
		"Pages",
		"Delete",
		"Remove",
		"Purge"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Th3S4mur41/cleanup-cloudflare-deployments.git"
	},
	"bugs": "https://github.com/Th3S4mur41/cleanup-cloudflare-deployments/issues",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">= 24.0.0",
		"npm": ">= 11.0.0"
	},
	"type": "module",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.0.2",
		"esbuild": "^0.28.2",
		"lefthook": "^2.1.10",
		"node-fetch": "^3.3.2",
		"semantic-release": "^25.0.9",
		"semantic-release-major-tag": "^0.3.2"
	},
	"scripts": {
		"build": "esbuild src/index.mjs --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module';const require = createRequire(import.meta.url);\" --outfile=dist/index.mjs",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"prepare": "lefthook install",
		"release": "semantic-release"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"body-max-line-length": [
				1,
				"always",
				140
			],
			"footer-max-line-length": [
				2,
				"always",
				140
			],
			"header-max-length": [
				2,
				"always",
				140
			]
		}
	}
}
